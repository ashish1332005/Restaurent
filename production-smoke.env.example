# Copy values into your deployment platform; do not commit real secrets.
SMOKE_BACKEND_URL=https://api.your-domain.com
SMOKE_FRONTEND_URL=https://app.your-domain.com
# Optional read-only authentication verification:
SMOKE_ADMIN_PHONE=
SMOKE_ADMIN_PASSWORD=

# Backend runtime pairing:
CORS_ORIGIN=https://app.your-domain.com
# Frontend Docker build argument:
API_BASE_URL=https://api.your-domain.com/api/v1
