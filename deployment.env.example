# Copy to deployment.env and load it before docker compose.
# This file contains public build/deployment settings only. Backend secrets stay
# in restaurant-backend-main/.env and must never be committed.
PUBLIC_API_BASE_URL=https://api.example.com/api/v1
FRONTEND_PORT=8080
BACKEND_PORT=5000
FRONTEND_BIND_ADDRESS=127.0.0.1
BACKEND_BIND_ADDRESS=127.0.0.1
GOOGLE_CLIENT_ID=
GOOGLE_SERVER_CLIENT_ID=

# Required backend .env production values:
# NODE_ENV=production
# MONGO_URI=mongodb+srv://... (replica-set/Atlas deployment)
# JWT_SECRET=<strong random value>
# JWT_EXPIRE=7d
# CORS_ORIGIN=https://app.example.com
# RAZORPAY_ENABLED=true
# RAZORPAY_KEY_ID=...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...