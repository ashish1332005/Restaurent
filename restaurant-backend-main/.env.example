NODE_ENV=production
PORT=5000
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/restaurant
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d
CORS_ORIGIN=https://your-frontend-domain.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated exact frontend origins; wildcard is rejected in production.
# Example: https://app.example.com,https://admin.example.com


# Customer online payments (use test keys before live mode)
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
